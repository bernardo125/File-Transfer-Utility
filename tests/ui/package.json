{
  "name": "ftu-ui-e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "End-to-end tests: real UI + real Go backends + real UDP/QUIC peers",
  "scripts": {
    "build:frontend": "npm --prefix ../../frontend run build",
    "test": "npm run build:frontend && playwright test",
    "test:ui": "npm run build:frontend && playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc -p .",
    "docs:video": "npm run build:frontend && playwright test -c playwright.docs.config.ts && python docs/encode.py"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2"
  }
}
